   <item>
    <widget class="QLabel" name="localLinkHelp">
     <property name="text">
      <string>Local Link connects consoles over a network, so it only works with games that have their own LAN or System Link mode, for example Gran Turismo 4, TimeSplitters 2 and Midnight Club 3. One device hosts and starts the game; every other device enters the host's address with the same port and room code. Each player needs their own copy of the game. A shared Wi-Fi network or a phone hotspot is easiest; over the internet, a VPN such as Tailscale on every device is the simplest way.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
