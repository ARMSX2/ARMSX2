    "GameDB Core Fixes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GameDB-Core-Fixes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arreglos del núcleo GameDB"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix core GameDB"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correções de núcleo GameDB"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GameDB 核心修复"
          }
        }
      }
    },
    "GameDB Core Fixes covers timing, clamps, and gamefixes. GameDB Graphics Fixes covers renderer-specific hardware fixes; turn it off globally or per-game if a title looks worse on Metal. Use Cheats & Patches from the in-game quick menu or a game's long-press menu to import and manage patch files." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GameDB-Core-Fixes umfassen Timing, Clamps und Gamefixes. GameDB-Grafik-Fixes umfassen renderer-spezifische Hardware-Fixes; deaktiviere sie global oder pro Spiel, wenn ein Titel auf Metal schlechter aussieht. Öffne Cheats & Patches im Schnellmenü oder Langdruckmenü eines Spiels, um Patch-Dateien zu importieren und zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GameDB Core cubre timing, clamps y arreglos. GameDB Graphics cubre fixes del renderer; apágalo globalmente o por juego si un título se ve peor en Metal. Usa Trucos y parches desde el menú rápido o el menú del juego para importar y gestionar archivos de parches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix core GameDB copre timing, clamp e gamefix. Fix grafici GameDB copre fix hardware specifici del renderer; disattivalo globalmente o per-gioco se un titolo appare peggio su Metal. Apri Trucchi e patch dal menu rapido o dal menu a pressione prolungata di un gioco per importare e gestire i file delle patch."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GameDB Core cobre timing, clamps e gamefixes. GameDB Graphics cobre fixes do renderer; desligue globalmente ou por jogo se piorar no Metal. Abra Cheats e patches no menu rápido ou no menu de toque prolongado do jogo para importar e gerenciar arquivos de patch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GameDB 核心修复涵盖时序、钳位和游戏修复。GameDB 图形修复涵盖渲染器相关硬件修复；如果某游戏在 Metal 下更差，可全局或按游戏关闭。请从游戏内快捷菜单或游戏长按菜单打开“作弊与补丁”，以导入和管理补丁文件。"
          }
        }
      }
    },
