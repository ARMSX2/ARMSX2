    "Scanline and CRT effects are subtle on high-resolution displays and are more visible at a lower Internal Resolution." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكون تأثيرات خطوط المسح وCRT خفيفة على الشاشات عالية الدقة، وتظهر أكثر عند خفض الدقة الداخلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanline- und CRT-Effekte sind auf hochauflösenden Bildschirmen dezent und bei einer niedrigeren internen Auflösung deutlicher sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los efectos de líneas de escaneo y CRT se notan poco en pantallas de alta resolución y se ven más con una resolución interna más baja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les effets de lignes de balayage et CRT sont discrets sur les écrans haute résolution et plus visibles avec une résolution interne plus basse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli effetti scanline e CRT sono poco visibili sugli schermi ad alta risoluzione e si notano di più con una risoluzione interna più bassa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走査線や CRT の効果は高解像度の画面では控えめで、内部解像度を下げるとはっきり見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주사선과 CRT 효과는 고해상도 화면에서는 약하게 보이고, 내부 해상도를 낮추면 더 잘 보입니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os efeitos de linhas de varredura e CRT são sutis em telas de alta resolução e ficam mais visíveis com uma resolução interna menor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在高分辨率屏幕上，扫描线和 CRT 效果不太明显，降低内部分辨率后会更明显。"
          }
        }
      }
    },
