    "Interpreter is slower, but can help isolate EE JIT crashes for specific games. Reset/relaunch after changing it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Interpreter ist langsamer, kann aber helfen, EE-JIT-Abstürze bei bestimmten Spielen einzugrenzen. Nach der Änderung zurücksetzen/neu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El intérprete es más lento, pero ayuda a aislar fallos del EE JIT. Reinicia tras cambiarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'interprete è più lento, ma può aiutare a isolare crash EE JIT in giochi specifici. Reimposta/riavvia dopo averlo cambiato."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O interpretador é mais lento, mas ajuda a isolar falhas do EE JIT. Reinicie após alterar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解释器较慢，但可用于排查某些游戏的 EE JIT 崩溃。更改后请重置/重启游戏。"
          }
        }
      }
    },
    "IOP" : {

    },
    "It appears in My Presets. It stops working if you delete or move the shader it came from." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر في My Presets. يتوقف عن العمل إذا حذفت المظلل الذي أُنشئ منه أو نقلته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erscheint in My Presets. Sie funktioniert nicht mehr, wenn du den Shader löschst oder verschiebst, aus dem sie entstanden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en My Presets. Deja de funcionar si borras o mueves el shader del que proviene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il apparaît dans My Presets. Il ne fonctionne plus si vous supprimez ou déplacez le shader dont il provient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare in My Presets. Smette di funzionare se elimini o sposti lo shader da cui deriva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Presets に表示されます。元のシェーダーを削除または移動すると使えなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Presets에 표시됩니다. 원본 셰이더를 삭제하거나 옮기면 작동하지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela aparece em My Presets. Ela para de funcionar se você apagar ou mover o shader de onde veio."
          }
