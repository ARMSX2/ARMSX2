    "Access is available. Confirm EE:JIT / IOP:JIT / VU:JIT in the in-game OSD.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 访问权限可用。请在游戏内 OSD 中确认 EE:JIT / IOP:JIT / VU:JIT。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso está disponible. Confirma EE:JIT / IOP:JIT / VU:JIT en el OSD del juego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff ist verfügbar. Bestätige EE:JIT / IOP:JIT / VU:JIT im OSD im Spiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso è disponibile. Conferma EE:JIT / IOP:JIT / VU:JIT nell'OSD in gioco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso está disponível. Confirme EE:JIT / IOP:JIT / VU:JIT no OSD dentro do jogo."
          }
        }
      }
    },
