    "ARMSX2 couldn’t identify this game’s patch version. Database matching is unavailable for now.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 无法识别此游戏对应的补丁版本。数据库匹配功能暂时不可用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على ARMSX2 تحديد إصدار التصحيح لهذه اللعبة. مطابقة قاعدة البيانات غير متاحة حالياً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 no pudo identificar la versión de parche de este juego. La coincidencia con la base de datos no está disponible por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 n'a pas pu identifier la version du correctif de ce jeu. La correspondance avec la base de données est indisponible pour le moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 konnte die Patch-Version dieses Spiels nicht identifizieren. Datenbankabgleich ist vorerst nicht verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 non è riuscito a identificare la versione della patch di questo gioco. La corrispondenza con il database non è al momento disponibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ARMSX2 não conseguiu identificar a versão do patch deste jogo. A correspondência com o banco de dados não está disponível no momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2はこのゲームのパッチバージョンを識別できませんでした。データベース照合は現在利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2가 이 게임의 패치 버전을 식별하지 못했습니다. 현재 데이터베이스 매칭을 사용할 수 없습니다."
          }
        }
      }
    },
    "ARMSX2 iOS menus will use this language where available. Some emulator terms and debug messages may still appear in English.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 iOS 菜单会尽量使用此语言。部分模拟器术语和调试消息可能仍以英文显示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستستخدم قوائم ARMSX2 iOS هذه اللغة عند توفرها. قد تظل بعض مصطلحات المحاكي ورسائل التصحيح باللغة الإنجليزية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los menús de ARMSX2 iOS usarán este idioma cuando esté disponible. Algunos términos del emulador y mensajes de depuración pueden seguir apareciendo en inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les menus d'ARMSX2 iOS utiliseront cette langue si disponible. Certains termes de l'émulateur et messages de débogage peuvent rester en anglais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menüs von ARMSX2 iOS verwenden diese Sprache, sofern verfügbar. Einige Emulatorbegriffe und Debugmeldungen können weiterhin auf Englisch erscheinen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I menu di ARMSX2 iOS useranno questa lingua dove disponibile. Alcuni termini dell'emulatore e messaggi di debug potrebbero rimanere in inglese."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os menus do ARMSX2 iOS usarão este idioma quando disponível. Alguns termos do emulador e mensagens de depuração ainda podem aparecer em inglês."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 iOS のメニューは、利用可能な場合この言語を使用します。一部のエミュレーター用語やデバッグメッセージは英語のまま表示される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2 iOS 메뉴는 가능한 경우 이 언어를 사용합니다. 일부 에뮬레이터 용어와 디버그 메시지는 영어로 표시될 수 있습니다."
          }
        }
      }
    },
