{
  "sourceLanguage": "en",
  "strings": {
    "%@ is installed. Reinstall or remove it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已安装。重新安装或移除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مثبت. أعد تثبيته أو قم بإزالته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está instalado. Reinstálalo o elimínalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est installé. Réinstallez-le ou supprimez-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist installiert. Neu installieren oder entfernen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è installato. Reinstallalo o rimuovilo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está instalado. Reinstale ou remova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がインストールされています。再インストールまたは削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 설치되어 있습니다. 재설치하거나 삭제하세요."
          }
        }
      }
    },
