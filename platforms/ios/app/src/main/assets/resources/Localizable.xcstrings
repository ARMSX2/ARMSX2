        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I menu di ARMSX2 iOS useranno questa lingua dove disponibile. Alcuni termini dell'emulatore e messaggi di debug potrebbero rimanere in inglese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ARMSX2 iOS のメニューは、利用可能な場合この言語を使用します。一部のエミュレーター用語やデバッグメッセージは英語のまま表示される場合があります。"
