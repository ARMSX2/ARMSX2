    "Access is available. Confirm EE:JIT / IOP:JIT / VU:JIT in the in-game OSD." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff ist verfügbar. Bestätige EE:JIT / IOP:JIT / VU:JIT im OSD im Spiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso está disponible. Confirma EE:JIT / IOP:JIT / VU:JIT en el OSD del juego."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso è disponibile. Conferma EE:JIT / IOP:JIT / VU:JIT nell'OSD in gioco."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso está disponível. Confirme EE:JIT / IOP:JIT / VU:JIT no OSD dentro do jogo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT 访问权限可用。请在游戏内 OSD 中确认 EE:JIT / IOP:JIT / VU:JIT。"
          }
        }
      }
    },
    "Achievement images download again the next time they are shown." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُنزَّل صور الإنجازات مرة أخرى عند عرضها في المرة القادمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfolgsbilder werden beim nächsten Anzeigen erneut geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes de logros se descargan de nuevo la próxima vez que se muestren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images des succès sont retéléchargées la prochaine fois qu'elles s'affichent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini degli obiettivi vengono riscaricate la prossima volta che vengono mostrate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実績の画像は次に表示されるときに再ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도전 과제 이미지는 다음에 표시될 때 다시 받습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens de conquistas são baixadas de novo na próxima vez que aparecerem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成就图片会在下次显示时重新下载。"
          }
        }
      }
    },
