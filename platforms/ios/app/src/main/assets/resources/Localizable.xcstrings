          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa globale"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar global"
          }
        },
        "ja": {
          "stringUnit": {
