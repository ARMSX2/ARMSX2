{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "A number that appears on top of a color swatch in the theme palette. The number is the number of times the color is used in the theme.",
      "isCommentAutoGenerated" : true
    },
    "%@  ·  CRC %@" : {
      "comment" : "A serial number and CRC of a game.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@  ·  CRC %2$@"
          }
        }
      }
    },
    "%@  %@" : {
      "comment" : "A game size, formatted for display.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@  %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "A title that displays the slot number.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ is installed. Reinstall or remove it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مثبت. أعد تثبيته أو قم بإزالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist installiert. Neu installieren oder entfernen."
          }
        },
        "es" : {
