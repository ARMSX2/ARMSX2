    "0 = Default. Negative = underclock (stable). Positive = overclock (fast but risky).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = 默认。负数 = 降频（稳定）。正数 = 超频（更快但有风险）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = predeterminado. Negativo = underclock estable. Positivo = overclock rápido pero riesgoso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = Standard. Negativ = Untertakten (stabil). Positiv = Übertakten (schnell, aber riskant)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = predefinito. Negativo = underclock (stabile). Positivo = overclock (veloce ma rischioso)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = padrão. Negativo = underclock estável. Positivo = overclock rápido mas arriscado."
          }
        }
      }
    },
