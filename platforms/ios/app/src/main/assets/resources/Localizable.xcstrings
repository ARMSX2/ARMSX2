            "state": "translated",
            "value": "Der Emulator-Cache konnte nicht gelesen werden, daher wurde nichts gelöscht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la cache dell'emulatore, quindi non è stato eliminato nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o cache do emulador, então nada foi apagado."
