    "Uses the same achievements core as ARMSX2 Android. Login tokens are stored in ARMSX2's local config; passwords are not stored by this screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet denselben Achievement-Kern wie ARMSX2 Android. Login-Tokens werden in der lokalen ARMSX2-Konfiguration gespeichert; Passwörter werden von diesem Bildschirm nicht gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
