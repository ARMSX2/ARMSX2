          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lo stesso core achievement di ARMSX2 Android. I token di accesso sono salvati nella configurazione locale di ARMSX2; le password non vengono salvate da questa schermata."
          }
        },
        "pt": {
