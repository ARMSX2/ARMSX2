    "Hardcore is enforced by the core and can restrict cheats, save states, and other non-hardcore features while active." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardcore wird vom Kern erzwungen und kann Cheats, Save States und andere Nicht-Hardcore-Funktionen einschränken, solange er aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardcore lo aplica el núcleo y puede restringir trucos, estados guardados y otras funciones no hardcore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardcore è applicato dal core e può limitare cheat, stati salvati e altre funzioni non-hardcore mentre è attivo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardcore é aplicado pelo núcleo e pode restringir cheats, save states e recursos não-hardcore."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硬核模式由核心强制执行，启用时可能限制作弊、即时存档和其他非硬核功能。"
          }
        }
      }
    },
