    "Can't reach the shader list. Check your connection and pull down to try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取着色器列表。请检查网络连接，然后下拉重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى قائمة المظللات. تحقّق من اتصالك واسحب للأسفل للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a la lista de shaders. Revisa tu conexión y desliza hacia abajo para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder à la liste des shaders. Vérifiez votre connexion et tirez vers le bas pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Shader-Liste ist nicht erreichbar. Prüfe deine Verbindung und zieh nach unten, um es erneut zu versuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l'elenco degli shader. Controlla la connessione e trascina verso il basso per riprovare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a lista de shaders. Verifique sua conexão e puxe para baixo para tentar de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェーダー一覧に接続できません。接続を確認し、下に引いて再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셰이더 목록에 연결할 수 없습니다. 연결을 확인하고 아래로 당겨 다시 시도하세요."
          }
        }
      }
    },
    "Can't reach the shader server. Check your connection and try again.": {
