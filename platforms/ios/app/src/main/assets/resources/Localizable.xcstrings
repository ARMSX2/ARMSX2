    "Boot this game once so ARMSX2 can identify it, then return to manage patches.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动一次此游戏以便 ARMSX2 进行识别，然后返回管理补丁。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل هذه اللعبة مرة واحدة حتى يتمكن ARMSX2 من التعرف عليها، ثم عد لإدارة التصحيحات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia este juego una vez para que ARMSX2 pueda identificarlo y luego regresa para administrar los parches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez ce jeu une fois pour qu'ARMSX2 puisse l'identifier, puis revenez pour gérer les correctifs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie dieses Spiel einmal, damit ARMSX2 es identifizieren kann, und kehren Sie dann zurück, um Patches zu verwalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia questo gioco una volta in modo che ARMSX2 possa identificarlo, quindi torna per gestire le patch."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicialize este jogo uma vez para que o ARMSX2 possa identificá-lo e depois retorne para gerenciar os patches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ARMSX2が識別できるようにこのゲームを一度起動してから、パッチを管理するために戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
