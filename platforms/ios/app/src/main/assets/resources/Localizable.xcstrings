    "Can't reach the shader list. Check your connection and pull down to try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى قائمة المظللات. تحقّق من اتصالك واسحب للأسفل للمحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Shader-Liste ist nicht erreichbar. Prüfe deine Verbindung und zieh nach unten, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
