    "That name belongs to the preset you're changing. Pick another name.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个名称属于你正在修改的预设。请换一个名称。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الاسم يخص الإعداد المسبق الذي تعدّله. اختر اسمًا آخر."
          }
        },
        "es": {
