    "File cards support 8 MB, 16 MB, 32 MB, and 64 MB. Folder cards match the ARMSX2/PCSX2 folder-card behavior and are useful for game-specific saves.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件记忆卡支持 8 MB、16 MB、32 MB 和 64 MB。文件夹记忆卡符合 ARMSX2/PCSX2 行为，适合按游戏保存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas de archivo soportan 8, 16, 32 y 64 MB. Las tarjetas de carpeta imitan ARMSX2/PCSX2 y sirven para partidas por juego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateikarten unterstützen 8 MB, 16 MB, 32 MB und 64 MB. Ordnerkarten entsprechen dem Ordnerkarten-Verhalten von ARMSX2/PCSX2 und sind nützlich für spielspezifische Speicherstände."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le card file supportano 8 MB, 16 MB, 32 MB e 64 MB. Le card cartella seguono il comportamento folder-card di ARMSX2/PCSX2 e sono utili per salvataggi specifici per gioco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões de arquivo suportam 8, 16, 32 e 64 MB. Cartões em pasta seguem ARMSX2/PCSX2 e são úteis para saves por jogo."
          }
        }
      }
    },
