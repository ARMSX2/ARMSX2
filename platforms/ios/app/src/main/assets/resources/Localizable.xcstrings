    "Tap a row, then press a button on your controller to assign it. L2/R2 are analog triggers (not remappable).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击一行，然后按下手柄按键进行绑定。L2/R2 是模拟扳机，不能重映射。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una fila y pulsa un botón del mando para asignarlo. L2/R2 son gatillos analógicos y no se pueden reasignar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Zeile und drücke dann eine Taste auf deinem Controller, um sie zuzuweisen. L2/R2 sind analoge Trigger (nicht neu belegbar)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una riga, poi premi un pulsante sul controller per assegnarlo. L2/R2 sono trigger analogici (non rimappabili)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma linha e pressione um botão no controle para atribuir. L2/R2 são gatilhos analógicos e não podem ser remapeados."
          }
        }
      }
    },
