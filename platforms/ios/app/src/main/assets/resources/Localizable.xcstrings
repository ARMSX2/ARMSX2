    "Achievement images download again the next time they are shown.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成就图片会在下次显示时重新下载。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُنزَّل صور الإنجازات مرة أخرى عند عرضها في المرة القادمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de logros se descargan de nuevo la próxima vez que se muestren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images des succès sont retéléchargées la prochaine fois qu'elles s'affichent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolgsbilder werden beim nächsten Anzeigen erneut geladen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini degli obiettivi vengono riscaricate la prossima volta che vengono mostrate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens de conquistas são baixadas de novo na próxima vez que aparecerem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実績の画像は次に表示されるときに再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도전 과제 이미지는 다음에 표시될 때 다시 받습니다."
          }
        }
      }
    },
