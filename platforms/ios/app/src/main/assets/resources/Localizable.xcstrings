          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo non rimuove mai giochi importati, file BIOS, stati salvati, memory card, copertine, impostazioni, file PNACH o pacchetti texture sostitutive."
          }
        },
        "pt" : {
          "stringUnit" : {
