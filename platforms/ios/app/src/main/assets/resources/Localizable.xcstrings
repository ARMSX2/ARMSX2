    "Auto enables Port 1 multitap when 3 or more controllers are detected before boot. Manual modes take effect on the next boot/reset.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动前检测到 3 个或更多手柄时，自动启用端口 1 Multitap。手动模式在下次启动/重置时生效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto activa multitap en el puerto 1 si detecta 3 o más mandos antes de iniciar. Los modos manuales se aplican al siguiente arranque/reinicio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto aktiviert Port-1-Multitap, wenn vor dem Start 3 oder mehr Controller erkannt werden. Manuelle Modi werden beim nächsten Start/Reset wirksam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto abilita il multitap della porta 1 quando vengono rilevati 3 o più controller prima dell'avvio. Le modalità manuali hanno effetto al prossimo avvio/reset."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto ativa multitap na porta 1 quando 3 ou mais controles são detectados antes do boot. Modos manuais valem no próximo boot/reset."
          }
        }
      }
    },
