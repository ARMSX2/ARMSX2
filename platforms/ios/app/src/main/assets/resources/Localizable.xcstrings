    "Games still need their in-game PS2 network setup. After changing DEV9 settings, use Reset ROM or restart the VM before testing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏仍需要在游戏内完成 PS2 网络设置。更改 DEV9 设置后，请先重置游戏或重启虚拟机再测试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos aún necesitan configurar la red PS2 dentro del juego. Tras cambiar DEV9, usa Reiniciar juego o reinicia la VM antes de probar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele benötigen weiterhin ihre PS2-Netzwerkeinrichtung im Spiel. Verwende nach dem Ändern der DEV9-Einstellungen ROM zurücksetzen oder starte die VM neu, bevor du testest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giochi richiedono comunque la configurazione di rete PS2 interna. Dopo aver cambiato le impostazioni DEV9, usa Reimposta ROM o riavvia la VM prima del test."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos ainda precisam da configuração de rede PS2 dentro do jogo. Após mudar DEV9, use Reiniciar jogo ou reinicie a VM antes de testar."
          }
        }
      }
    },
