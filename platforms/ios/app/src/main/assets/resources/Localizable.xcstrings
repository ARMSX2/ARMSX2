    "Default restores global settings; other presets change only their listed settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستعيد \"الافتراضي\" الإعدادات العامة؛ بينما تغير الإعدادات المسبقة الأخرى الإعدادات المدرجة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Standard“ stellt die globalen Einstellungen wieder her; andere Voreinstellungen ändern nur die aufgeführten Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Por defecto\" restaura la configuración global; otros ajustes preestablecidos solo cambian las opciones indicadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Par défaut » restaure les réglages généraux ; les autres préréglages ne modifient que les réglages indiqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Predefinito\" ripristina le impostazioni globali; gli altri preset modificano solo le impostazioni elencate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デフォルト」は全体設定を復元します。他のプリセットは記載された設定のみを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"기본값\"은 전역 설정을 복원하며, 다른 프리셋은 나열된 설정만 변경합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Padrão\" restaura as configurações globais; outras predefinições alteram apenas as configurações listadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“默认”恢复全局设置；其他预设仅更改其列出的设置。"
          }
        }
      }
    },
