<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="archos.permission.FULLSCREEN.FULL" />
    <!-- Cover artwork can be loaded from the configured remote artwork source. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Optional motion controls (Pad settings). Not required, so the Play install
         isn't gated for devices without a gyroscope. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!--
        The Discord Social SDK .aar is now a real dependency, so its manifest merges into ours and
        brings its <queries> for CustomTabsService with it — no need to restate that here.

        What we DO have to undo is its voice permissions. The SDK declares RECORD_AUDIO, three
        foreground-service permissions and Bluetooth for features we do not ship, and merged
        unchallenged they would put "Microphone" on the Play listing and require a data-safety
        declaration for a capability that does not exist in this app.

        tools:node="remove" is the supported way to drop a merged permission, and it is checked:
        build-play-aab.sh fails the build if RECORD_AUDIO or REQUEST_INSTALL_PACKAGES survive into
        the bundle, so a regression here cannot ship quietly.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <!-- The SDK's voice foreground service goes with them; we never start a call. -->

    <application
        android:name=".Pasx2Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@style/Theme.ARMSX2"
        android:allowNativeHeapPointerTagging="false"
        tools:targetApi="31"
        >
        <!-- Declare game mode support (Android 12+) — routes app through GameManager
             performance profile so the OS scheduler and CPU/GPU governors prefer
             big cores and peak clocks instead of throttling as a normal app. -->
        <meta-data android:name="android.app.game_mode" android:value="performance" />

        <!-- Profileable from the adb shell. Lets simpleperf record from the
             release build without flipping debuggable on (which would also
             change the JIT path and skew the numbers). -->
        <profileable android:shell="true" tools:targetApi="29" />

        <meta-data android:name="android.max_aspect" android:value="2.4" />

        <activity
            android:name=".BootSplashActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:exported="true"
            android:resizeableActivity="false"
            android:theme="@style/Theme.ARMSX2.Boot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.GAME" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Main"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:exported="true"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivity"
            android:exported="true"
            android:targetActivity=".Main">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".RetroAchievementsHostOverrideReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.action.SET_RETROACHIEVEMENTS_HOST_OVERRIDE" />
                <action android:name="${applicationId}.action.CLEAR_RETROACHIEVEMENTS_HOST_OVERRIDE" />
            </intent-filter>
        </receiver>

        <!--
            Discord Social SDK's OAuth landing activity. Declared here rather than inherited from
            the vendor .aar on purpose: that .aar's manifest also declares RECORD_AUDIO, three
            foreground-service permissions and Bluetooth for its voice features, and the merger
            would fold every one of them into ARMSX2 — the Play listing would show "Microphone" and
            need a data-safety declaration for a feature we do not ship. Declaring only this one
            activity means we inherit no permissions at all.

            The scheme must match the redirect URI registered in the Discord developer portal
            (discord-<application id>) or the browser hands the code back to nothing and the sign-in
            silently never completes. Same id as kApplicationId in cpp/discord_bridge.cpp.

            Its ForegroundService is deliberately NOT declared — it exists for voice.
        -->
        <activity
            android:name="com.discord.socialsdk.AuthenticationActivity"
            android:process=":discord"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="discord-1531447040435814411" />
            </intent-filter>
        </activity>

        <!-- Voice-only; we never start a call, and a declared foreground service we never use is
             just Play-review surface. -->
        <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />

        <!--
            The Discord helper, in its own process.

            android:process=":discord" is the whole point, not a performance choice. ARMSX2 is
            GPL-3.0+ and the Discord Social SDK is proprietary with no published licence; linking
            them into one binary would make the emulator a combined work with a library whose
            corresponding source cannot be supplied. Two programs exchanging messages over IPC is
            a different thing, and this attribute is what makes that true at runtime: the SDK's
            .so is loaded only here, and libemucore has no DT_NEEDED on it.

            Not exported — nothing outside this app has any business binding it.

            DiscordAuthActivity must share the process: the SDK launches sign-in through an
            Activity handed to it, and one from the app process would be unusable from here.
        -->
        <service
            android:name="com.armsx2.discord.DiscordService"
            android:process=":discord"
            android:exported="false" />

        <activity
            android:name="com.armsx2.discord.DiscordAuthActivity"
            android:process=":discord"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false" />
    </application>



</manifest>
