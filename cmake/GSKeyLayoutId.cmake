#
# Script mode: writes OUT, a header defining GS_TFX_KEY_LAYOUT_ID, the hash of what a recorded Vulkan
# pipeline key's bits mean: in each file of FILES (absolute paths, '|'-separated) the text between the
# markers "TFX pipeline key layout: begin" and "TFX pipeline key layout: end", or the whole file when it
# has none. The key lists are named by it instead of by the GS build identity, so they survive every
# build that leaves the key layout alone (a key names a pipeline; the code that builds it may change).

string(REPLACE "|" ";" FILES "${FILES}")
set(text "")
foreach(f IN LISTS FILES)
	file(READ "${f}" content)
	get_filename_component(name "${f}" NAME)
	string(FIND "${content}" "TFX pipeline key layout: begin" pos)
	if(pos EQUAL -1)
		string(APPEND text "${name}\n${content}\n")
		continue()
	endif()
	while(NOT pos EQUAL -1)
		string(SUBSTRING "${content}" ${pos} -1 content)
		string(FIND "${content}" "TFX pipeline key layout: end" end)
		if(end EQUAL -1)
			message(FATAL_ERROR "${f}: a key layout begin marker without an end")
		endif()
		string(SUBSTRING "${content}" 0 ${end} region)
		string(APPEND text "${name}\n${region}\n")
		string(SUBSTRING "${content}" ${end} -1 content)
		string(FIND "${content}" "TFX pipeline key layout: begin" pos)
	endwhile()
endforeach()
string(SHA256 id "${text}")
string(SUBSTRING "${id}" 0 32 id)

set(content "// Generated by cmake/GSKeyLayoutId.cmake. Do not edit.\n#pragma once\n#define GS_TFX_KEY_LAYOUT_ID \"${id}\"\n")
if(EXISTS "${OUT}")
	file(READ "${OUT}" old)
else()
	set(old "")
endif()
if(NOT old STREQUAL content)
	file(WRITE "${OUT}" "${content}")
endif()
